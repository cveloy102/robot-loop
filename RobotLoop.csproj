<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RobotLoop</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\icon-a-loop.ico</ApplicationIcon>
    <Version>1.2.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\icon-a-loop.ico" LogicalName="RobotLoop.AppIcon" />
    <EmbeddedResource Include="assets\fonts\*.ttf" LogicalName="RobotLoop.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
